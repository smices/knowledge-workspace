APP_PORT=8000
APP_BIND=0.0.0.0
SERVICE_BIND=127.0.0.1
KAFKA_PORT=9094
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+psycopg://rag:replace-with-a-random-password@postgres:5432/rag
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_chunks_hybrid_v1
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_DOCUMENT_TOPIC=knowledge.documents
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=replace-with-an-access-key
S3_SECRET_KEY=replace-with-a-random-secret
S3_BUCKET=knowledge
S3_REGION=us-east-1
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=replace-with-model-api-key
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
CHAT_MODEL=qwen3:8b
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
AUTH_MODE=dev
IDENTITY_ISSUER=https://idp.example.invalid/realms/example
IDENTITY_CLIENT_ID=knowledge-app
IDENTITY_CLIENT_SECRET=
IDENTITY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
IDENTITY_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:8000/
IDENTITY_SCOPE="openid profile email"
IDENTITY_DEFAULT_TENANT_ID=local
IDENTITY_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
IDENTITY_SESSION_COOKIE=knowledge_session
IDENTITY_COOKIE_SECURE=false
IDENTITY_SESSION_MAX_SECONDS=28800
# Optional in local development; required on the first OIDC installation.
# LOCAL_ADMIN_USERNAME=initial-admin
# LOCAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
BRAND_NAME="Knowledge Workspace"
BRAND_MARK=K
BRAND_TAGLINE=企业知识助手
BRAND_FOOTER="Evidence first"
BRAND_PRIMARY_COLOR="#4f5bd5"
BRAND_LOGO_URL=
